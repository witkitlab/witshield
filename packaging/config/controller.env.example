# Installed as /etc/witshield/controller.env with mode 0600.
# Do not commit the populated file.
WITSHIELD_LISTEN=127.0.0.1:8080
WITSHIELD_DATA_DIR=/var/lib/witshield
# Optional when UI files are installed outside the binary.
WITSHIELD_WEB_DIR=/usr/share/witshield/web
# 仅当反向代理与 Controller 同机并通过 loopback 连接时启用；代理必须
# 覆盖客户端提交的 X-Forwarded-For/X-Forwarded-Proto/Forwarded。
# WITSHIELD_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Native systemd unit reads the one-time administrator bootstrap secret from:
# /var/lib/witshield/bootstrap.token (0600, remove after bootstrap).
