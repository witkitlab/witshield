# Installed as /etc/witshield/agent.env with mode 0600.
# Do not commit the populated file.
# Remote native Agents require HTTPS. A standalone installation generates its
# installation-owned unix:///run/witshield-controller/agent.sock value itself.
WITSHIELD_CONTROLLER_URL=https://shield.example.com
WITSHIELD_DEVICE_NAME=replace-with-device-name
WITSHIELD_DATA_DIR=/var/lib/witshield-agent
WITSHIELD_SCAN_INTERVAL=24h
# Optional when the distribution writes SSH authentication events elsewhere.
# WITSHIELD_AUTH_LOG=/var/log/auth.log
# Native mode defaults to this fixed executable and persists a journald cursor.
WITSHIELD_JOURNALCTL=/usr/bin/journalctl
# Optional Falco-compatible JSONL stream. Missing file is shown as optional,
# not as a false all-clear.
WITSHIELD_RUNTIME_EVENT_LOG=/var/log/falco/events.jsonl
# Preferred: a regular Agent-only file. Agent removes it after exchanging the
# token for an independent device identity when --consume-enrollment-token is set.
WITSHIELD_ENROLLMENT_TOKEN_FILE=/var/lib/witshield-agent/enrollment.token
WITSHIELD_HELPER_SOCKET=/run/witshield/helper.sock
WITSHIELD_HELPER_TOKEN_FILE=/etc/witshield/helper.token
